# Kormic Commons — Environment Variables
# Copy this to .env and fill in your values
# NEVER commit .env to git
# Required: independent Fernet key(s) for encrypted TOTP seeds. Generate with:
# python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# First key writes; remaining comma-separated keys are decryption fallbacks.
# Inject from your secret manager in production. See TOTP_SECURITY.md.
TOTP_SECRET_KEYS=

# Django core.
# Local dev: leave DJANGO_SECRET_KEY unset (generates an ephemeral debug-only key),
# DJANGO_DEBUG=true, DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1 (all defaults
# below already match this -- you don't strictly need to set them for
# local dev). Both DJANGO_DEBUG and DJANGO_ALLOWED_HOSTS now default to
# fail-closed (False / localhost-only) if left unset entirely, so a
# misconfigured deploy can no longer silently open a debug server to the
# internet -- see deployment_checklist_to_do.md for what MUST be set
# on any server reachable outside localhost (e.g. EC2).
DJANGO_SECRET_KEY=
DJANGO_DEBUG=true
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
# Comma-separated frontend origins allowed to call the API cross-origin.
# Exact HTTPS origins, also trusted for CSRF. No wildcards. See WEB_AUTH.md.
# Blank permits only local development ports when DEBUG=true; none in production.
DJANGO_CORS_ALLOWED_ORIGINS=

# Shared cache (Redis) -- backs DRF's per-IP/per-email rate limiting and the
# TOTP replay/lockout cache. Must be reachable from every gunicorn worker;
# LocMemCache (Django's default) silently breaks rate limiting once you run
# more than one worker process, so this project no longer uses it.
DJANGO_CACHE_URL=redis://localhost:6379/2

# PostgreSQL. docker-compose.yml uses these same DB/user/password values for
# postgres, migrations, web and Celery. The password is required by Compose;
# generate a strong unique value before `docker compose up`.
# When Django runs directly on the host use localhost. Compose overrides only
# POSTGRES_HOST to the Docker service name `postgres` internally.
POSTGRES_DB=kormic
POSTGRES_USER=kormic
POSTGRES_PASSWORD=
POSTGRES_HOST=localhost
POSTGRES_PORT=5432

# DB connection pooling -- seconds a pooled connection is reused before
# being recycled. 0 disables pooling (a fresh connection per request/task).
DB_CONN_MAX_AGE=60

# Console log verbosity (DEBUG/INFO/WARNING/ERROR). Logs go to stdout/stderr
# -- pick these up via `docker logs` / your container platform's log driver.
DJANGO_LOG_LEVEL=INFO

# gunicorn (production WSGI server -- see docker-compose.yml's `web`
# command). Size GUNICORN_WORKERS to the host's CPU count (~2×cores+1).
# GUNICORN_EXTRA_ARGS is a local-dev-only escape hatch: set it to "--reload"
# for hot-reload-on-save; leave it UNSET in any real deployment.
GUNICORN_WORKERS=3
GUNICORN_TIMEOUT=120
GUNICORN_EXTRA_ARGS=

ANTHROPIC_API_KEY=your_anthropic_api_key_here

# Max Postgres connections held per gunicorn worker by the student-agent
# chat checkpointer (pure_multi_agent/runtime.py -- one pool per worker
# process, opened at import time).
AGENT_CHECKPOINTER_POOL_SIZE=5

# Optional: PostgreSQL for persistent knowledge base
# If not set, knowledge base runs in memory only
# DATABASE_URL=postgresql://user:password@localhost:5432/kormic_commons

GITHUB_OAUTH_CLIENT_ID=your_github_oauth_client_id
GITHUB_OAUTH_CLIENT_SECRET=your_github_oauth_client_secret
GITHUB_OAUTH_REDIRECT_URI=http://localhost:8000/api/v1/auth/github/callback/
GITHUB_OAUTH_TOKEN_KEY=generate_with_fernet_as_shown_above

# Celery / Redis -- background delivery for push notifications
CELERY_BROKER_URL=redis://localhost:6379/0
CELERY_RESULT_BACKEND=redis://localhost:6379/1
# Set to true only in tests/local dev without a running worker -- runs tasks
# inline instead of enqueueing them.
CELERY_TASK_ALWAYS_EAGER=false

# Proactive check-in scan (see CELERY_BEAT_SCHEDULE / notifications/tasks.py)
# fans out one Celery sub-task per this many students, each of which sends
# its pushes as ~1 batched Expo call instead of 1-per-student.
# Hour of day in Django/Celery timezone (0-23), not an interval.
PROACTIVE_CHECKIN_HOUR=9
PROACTIVE_CHECKIN_COOLDOWN_DAYS=7
PROACTIVE_CHECKIN_BATCH_SIZE=50

# Expo push notifications (student mobile app)
EXPO_PUSH_ACCESS_TOKEN=

# EMAIL_MODE picks the backend, independent of DJANGO_DEBUG (defaults to
# "dev" when DJANGO_DEBUG=true and "prod" otherwise if left unset here):
#   dev  -- Ethereal only, using the ETHEREAL_* creds below. Nothing is
#           ever really delivered.
#   prod -- real SMTP only, using the EMAIL_* creds below. Nothing goes to
#           Ethereal.
#   dual -- BOTH: every message is shadow-sent to Ethereal for QA to
#           inspect, and real recipients (any address whose domain isn't
#           in FAKE_EMAIL_DOMAINS -- seeded test rows like abc@test.com)
#           also get a real send through EMAIL_* -- so you can check
#           actual deliverability (Gmail spam scoring etc) against a real
#           inbox. Requires every EMAIL_* AND ETHEREAL_* var below to be
#           filled in -- Django refuses to start and names the missing
#           one otherwise, rather than silently sending nothing.
EMAIL_MODE=dev
FAKE_EMAIL_DOMAINS=test.com,example.com,example.net,example.org,test,invalid,localhost

# Real/private mail provider -- used by "prod" and "dual". Required
# (non-empty) in both those modes.
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USE_TLS=true
EMAIL_USE_SSL=false
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
DEFAULT_FROM_EMAIL=no-reply@kormic.example.com

# Ethereal sandbox -- used by "dev" and "dual". Create a test inbox at
# https://ethereal.email and put its generated user/pass here. Host
# defaults to Ethereal's public endpoint, so only the user/pass are
# normally needed.
ETHEREAL_HOST=smtp.ethereal.email
ETHEREAL_PORT=587
ETHEREAL_USE_TLS=true
ETHEREAL_USE_SSL=false
ETHEREAL_HOST_USER=
ETHEREAL_HOST_PASSWORD=

# Comma-separated emails notified when the student agent starts failing
# (e.g. Anthropic credit exhaustion) and again once it recovers -- see
# extra_utils/send_mail_to_superuser.py. Leave unset and no one is
# notified (a warning is logged on each failure instead).
AGENT_ALERT_EMAILS=

# Public mobile invitations. Deploy APP_LINKS.md before enabling invite delivery.
# Add app.kormic.ai to DJANGO_ALLOWED_HOSTS in production.
# Required by the backend and Celery worker when sending invitation emails.
# This is the student frontend/deep-link URL, not the Django API URL.
# Use the public /claim page without a query string; the backend appends ?token=...
CLAIM_PAGE_URL=http://localhost:8081/claim
# Comma-separated Play app-signing SHA-256 certificates, each colon-separated.
APP_LINK_ANDROID_SHA256_FINGERPRINTS=
# Usually Apple Team ID; use the signed app's application-identifier prefix.
APP_LINK_APPLE_APP_ID_PREFIX=
# Actual published store listings; leave empty until available.
APP_LINK_ANDROID_STORE_URL=
APP_LINK_IOS_STORE_URL=


# Chat policies: dedicated Linux/prefork chat queue is required; see CHAT_OPERATIONS.md.
CHAT_MODEL_TIMEOUT_SECONDS=20
CHAT_TURN_SECONDS=75
CHAT_REQUESTS_PER_MINUTE=6
CHAT_DAILY_TOKENS=250000
CHAT_DAILY_USD=5
# Conservative operator-set upper bounds, NOT a provider price quote.
CHAT_INPUT_USD_PER_MILLION=15
CHAT_OUTPUT_USD_PER_MILLION=75
CHAT_MAX_MODEL_CALLS=10
CHAT_MAX_TOOL_CALLS=8
CHAT_MAX_UNIVERSITIES_PER_TURN=4
CHAT_UNIVERSITY_CONCURRENCY=2
CHAT_GLOBAL_PENDING_LIMIT=100
CHAT_MAX_MESSAGE_CHARS=8000
CHAT_MAX_ATTACHMENTS=3
CHAT_MAX_ATTACHMENT_BYTES=5242880
CHAT_MAX_TOTAL_ATTACHMENT_BYTES=10485760
PURE_MULTI_AGENT_VERBOSE=false

# Hybrid university knowledge retrieval. Keep provider keys server-side.
VOYAGE_API_KEY=
KNOWLEDGE_EMBEDDING_MODEL=voyage-4-lite
# Exact model-id -> current per-million token prices. Empty means unknown cost.
# Example schema only (not real prices): {"model-id":{"input":1,"output":2}}
MODEL_COST_RATES_JSON={}

# Publish API only to the local reverse proxy by default. Set 0.0.0.0 only for a controlled LAN pilot.
API_BIND_ADDRESS=127.0.0.1

# Institute CSV intake: 5 MiB / 5,000 rows; raw sheets retained for at most 30 days.
INSTITUTE_ROSTER_MAX_BYTES=5242880
INSTITUTE_ROSTER_MAX_ROWS=5000
INSTITUTE_SOURCE_FILE_RETENTION_DAYS=30

# HTTPS is required by default when DEBUG=false. Local HTTP development uses DEBUG=true.
# Trust ONLY the IP/CIDR of your controlled proxy, which must overwrite X-Forwarded-Proto.
# Leave blank if the WSGI server receives TLS directly. Never use 0.0.0.0/0.
DJANGO_TRUSTED_PROXY_CIDRS=
# HSTS defaults to 3600 seconds in production. Increase after validating TLS.
# Subdomain/preload policy is deliberately opt-in after confirming all affected hosts.
DJANGO_HSTS_INCLUDE_SUBDOMAINS=false
DJANGO_HSTS_PRELOAD=false
