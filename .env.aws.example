# Copy to .env.aws. Never commit the resulting secret file.
DJANGO_SECRET_KEY=
TOTP_SECRET_KEYS=
DJANGO_ALLOWED_HOSTS=api.example.com,localhost,127.0.0.1
# Exact frontend origins, no paths or trailing slash. Custom domains preferred.
DJANGO_CORS_ALLOWED_ORIGINS=https://app.example.com,https://admin.example.com,https://university.example.com
WEB_COOKIE_SAMESITE=Lax
POSTGRES_DB=kormic
POSTGRES_USER=kormic
POSTGRES_PASSWORD=
OLLAMA_MODEL=qwen3:1.7b
OLLAMA_IMAGE=ollama/ollama:latest
OLLAMA_CPUS=1.0
OLLAMA_MEMORY_LIMIT=2g
OLLAMA_MEMORY_SWAP_LIMIT=3g
KORMIC_HTTP_PORT=8030
GUNICORN_WORKERS=1
ANTHROPIC_API_KEY=
GITHUB_TOKEN=
GITHUB_OAUTH_CLIENT_ID=
GITHUB_OAUTH_CLIENT_SECRET=
GITHUB_OAUTH_REDIRECT_URI=https://api.example.com/api/auth/github/callback/
CLAIM_PAGE_URL=https://app.example.com/claim
EMAIL_MODE=prod
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_USE_TLS=true
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
DEFAULT_FROM_EMAIL=

# Turn on after the updated student app and models are deployed together.
STUDENT_FACE_AUTH_REQUIRED=false
STUDENT_FACE_ENCRYPTION_KEY=
FACE_MODEL_DIRECTORY=/app/face_models
STUDENT_FACE_MATCH_THRESHOLD=0.42
